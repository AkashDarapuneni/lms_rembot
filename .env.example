# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Used to encrypt users' Moodle tokens in the database. Keep it secret and do not lose it.
SECRET_KEY=

DB_PATH=moodle_bot.sqlite3
SYNC_MINUTES=15

# Default Moodle site shown in /start. Only this host is accepted unless ALLOW_ANY_SITE=1
DEFAULT_SITE=lms.kluniversity.in
ALLOW_ANY_SITE=0

# Public HTTPS address of this server (Telegram Mini Apps require HTTPS). Leave empty to disable the Connect button.
WEBAPP_URL=
PORT=8080

# Remote database (needed on Render free). mysql://USER:PASS@HOST:4000/DB for TiDB Cloud, or postgresql://... Leave empty to use the local SQLite file.
DATABASE_URL=

# Optional: Google Gemini API key. When set, Gemini writes fresh dialogue lines; the lines in punchlines.json are the fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional extras
# ADMIN_IDS=123456789            # your Telegram ID: lets you teach memes/GIFs (send with caption "meme any") and use /botstats
# LINE_REUSE_DAYS=3              # a dialogue is not repeated for this many days
# GEMINI_SHARE_DEADLINES=0       # 0 = never send task names to Gemini when answering questions
